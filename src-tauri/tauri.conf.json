{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PD2 Filter Forge",
  "version": "0.3.6",
  "identifier": "com.pd2filterforge.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1427",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PD2 Filter Forge",
        "width": 1480,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://raw.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Loot filter editor for Project Diablo 2"
  }
}
